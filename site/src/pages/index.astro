---
import '../styles/global.css';
import { Code } from 'astro:components';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CopyCommand from '../components/CopyCommand.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { readFateStats } from '../lib/fate.js';

const fate = readFateStats();
const coverage = fate ? `${fate.compat.rate}%` : '86.9%';

const title = 'wasmpeg — FFmpeg for the browser, built for the decode → display loop';
const description =
    'Decode video to RGBA frames in the browser from a 2.9 MB gzipped WASM — no SharedArrayBuffer, ' +
    'no COOP/COEP headers. Frames, audio, metadata, and thumbnails, with GPU scaling when available.';

const sample = `import wasmpeg from 'wasmpeg';

await wasmpeg.load();

// any File / Blob / URL / Uint8Array
const dec = await wasmpeg.decode(file);
let frame;
while ((frame = dec.nextFrame())) {
  // frame: Uint8ClampedArray of RGBA8 pixels
  ctx.putImageData(new ImageData(frame, dec.width, dec.height), 0, 0);
}
dec.close();`;

const stats = [
    { value: '2.9 MB', label: 'gzipped WASM' },
    { value: '0', label: 'special headers' },
    { value: 'Node 18+', label: 'and every browser' },
    { value: coverage, label: 'FATE coverage' },
];

const features = [
    { n: '01', title: 'No cross-origin isolation', body: 'Loads without SharedArrayBuffer and without COOP/COEP headers. Drop it into any page on any host — no special server config.' },
    { n: '02', title: 'Frames as RGBA8', body: 'nextFrame() returns a Uint8ClampedArray, ready for putImageData or a WebGL/WebGPU texture upload. No format juggling.' },
    { n: '03', title: 'GPU scaling, CPU fallback', body: 'Scales on WebGPU when the browser supports it, and falls back to libswscale on the CPU automatically. Same call either way.' },
    { n: '04', title: 'Audio & metadata too', body: 'Decode any supported stream to interleaved float PCM, and probe container metadata without decoding a single frame.' },
    { n: '05', title: 'Runs in Node', body: 'The identical API works server-side in Node ≥ 18 — handy for tests, thumbnails, and pipelines.' },
    { n: '06', title: 'FATE-tested', body: 'Tracked against FFmpeg’s own regression suite on two axes: does it decode, and does it match byte-for-byte.' },
];

const apis = [
    { tier: 'High', name: "import wasmpeg from 'wasmpeg'", when: 'A File / Blob / URL / canvas in, frames or metadata out. Start here.', href: '/start/introduction/' },
    { tier: 'Compat', name: "import { FFmpeg } from 'wasmpeg'", when: 'The @ffmpeg/ffmpeg-style load / writeFile / exec surface.', href: '/reference/ffmpeg-class/' },
    { tier: 'Low', name: "import { gpu } from 'wasmpeg'", when: 'Raw bytes or RGBA in hand, manual lifecycle control.', href: '/reference/gpu/' },
];

const capabilities = [
    {
        eyebrow: 'Frames',
        title: 'Decode to a canvas',
        body: 'Pull frames one at a time as RGBA8 and paint them straight to a canvas — no copies, no format juggling.',
        href: '/guides/decode-video/',
        code: `const dec = await wasmpeg.decode(file);
const ctx = canvas.getContext('2d');

let frame;
while ((frame = dec.nextFrame())) {
  ctx.putImageData(
    new ImageData(frame, dec.width, dec.height), 0, 0);
}
dec.close();`,
    },
    {
        eyebrow: 'Thumbnails',
        title: 'Grab a thumbnail',
        body: 'Encode the first frame to a JPEG or PNG — perfect for poster images and previews, at any size.',
        href: '/guides/encode/',
        code: `// first-frame JPEG at 320×180
const jpg = await wasmpeg.encode(file, {
  codec: 'mjpeg',
  width: 320,
  height: 180,
  frames: 1,
});`,
    },
    {
        eyebrow: 'Metadata',
        title: 'Probe without decoding',
        body: 'Read container format, duration, bitrate, and per-stream details before you commit to a decode.',
        href: '/guides/probe/',
        code: `const info = await wasmpeg.probe(file);

info.duration;        // 12.4  (seconds)
info.video.width;     // 1920
info.audio.channels;  // 2
info.streams;         // [{ index, type }, …]`,
    },
    {
        eyebrow: 'Audio',
        title: 'Decode audio to PCM',
        body: 'Get interleaved 32-bit float samples, ready to drop straight into the Web Audio API.',
        href: '/guides/decode-audio/',
        code: `const aud = await wasmpeg.decodeAudio(file);

let chunk;
while ((chunk = aud.nextSamples())) {
  // Float32Array, interleaved, [-1, 1]
}
aud.close();`,
    },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <ThemeScript />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href="https://wasmpeg.pages.dev/" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://wasmpeg.pages.dev/og.png" />
        <meta name="twitter:card" content="summary_large_image" />
    </head>
    <body class="m-0 min-h-screen bg-[var(--bg)] font-sans text-[var(--fg)] antialiased">
        <SiteNav />

        <!-- hero -->
        <section class="relative overflow-hidden">
            <div class="hero-grid pointer-events-none absolute inset-0 -z-10"></div>
            <div class="mx-auto max-w-5xl px-6">
                <div class="mx-auto max-w-3xl px-1 pt-16 pb-12 text-center sm:pt-24 sm:pb-14">
                    <p class="mb-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--fg-subtle)] sm:text-xs">
                        <span class="h-1.5 w-1.5 rounded-full bg-sky-400 shadow-[0_0_8px_0] shadow-sky-400/70"></span>
                        FFmpeg · WebAssembly
                    </p>
                    <h1 class="bg-linear-to-b from-[var(--fg-strong)] to-[var(--fg-muted)] bg-clip-text text-balance text-4xl font-semibold leading-[1.08] tracking-tight text-transparent sm:text-5xl md:text-6xl">
                        Decode video in the
                        <span class="bg-linear-to-r from-sky-400 to-cyan-300 bg-clip-text text-transparent">browser.</span>
                    </h1>
                    <p class="mx-auto mt-6 max-w-xl text-pretty text-lg leading-relaxed text-[var(--fg-muted)]">
                        RGBA frames, audio, and metadata from a 2.9&nbsp;MB gzipped WASM — with no
                        SharedArrayBuffer and no COOP/COEP headers required.
                    </p>
                    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
                        <a
                            href="/start/introduction/"
                            class="rounded-md btn-primary px-4 py-2 text-sm font-medium no-underline transition"
                            >Get started</a
                        >
                        <a
                            href="/start/quick-start/"
                            class="rounded-md border border-[var(--hairline-strong)] px-4 py-2 text-sm font-medium text-[var(--fg)] no-underline transition hover:border-sky-400/40 hover:bg-[var(--panel-hover)] hover:text-[var(--fg-strong)]"
                            >Documentation</a
                        >
                    </div>
                    <div class="mt-6 flex justify-center">
                        <CopyCommand command="npm install wasmpeg" />
                    </div>
                </div>

                <!-- code window -->
                <div class="relative mx-auto max-w-2xl pb-6">
                    <div class="pointer-events-none absolute -inset-x-10 -top-10 -z-10 h-44 bg-[radial-gradient(45%_100%_at_50%_0%,rgba(56,189,248,0.13),transparent)]"></div>
                    <div class="rounded-xl bg-linear-to-b from-[var(--hairline-strong)] to-transparent p-px shadow-2xl shadow-black/50">
                        <div class="overflow-hidden rounded-[11px] border border-[var(--hairline)] bg-[var(--code-bg)]">
                            <div class="flex items-center justify-between border-b border-[var(--hairline)] px-4 py-2.5">
                                <span class="font-mono text-xs text-[var(--fg-subtle)]">decode-loop.js</span>
                                <span class="font-mono text-[11px] text-[var(--fg-faint)]">javascript</span>
                            </div>
                            <div class="landing-code overflow-x-auto">
                                <Code code={sample} lang="js" theme="vesper" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- stats strip -->
        <section class="mx-auto mt-14 max-w-5xl px-6">
            <div class="grid grid-cols-2 border-t border-l border-[var(--hairline)] sm:grid-cols-4">
                {
                    stats.map((s) => (
                        <div class="border-b border-r border-[var(--hairline)] px-6 py-7">
                            <div class="font-mono text-2xl tracking-tight text-[var(--fg-strong)]">{s.value}</div>
                            <div class="mt-1.5 text-sm text-[var(--fg-subtle)]">{s.label}</div>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- features -->
        <section class="mx-auto max-w-5xl px-6 pt-24">
            <h2 class="text-2xl font-semibold tracking-tight text-[var(--fg-strong)]">
                Built for the decode → display loop
            </h2>
            <p class="mt-3 max-w-xl text-[var(--fg-muted)]">
                A focused, decode-first FFmpeg build — not a general-purpose transcoder.
            </p>
            <div class="mt-10 grid border-t border-l border-[var(--hairline)] sm:grid-cols-2 lg:grid-cols-3">
                {
                    features.map((f) => (
                        <div class="group border-b border-r border-[var(--hairline)] p-6 transition-colors hover:bg-[var(--panel-hover)]">
                            <div class="font-mono text-xs text-[var(--fg-faint)] transition-colors group-hover:text-sky-400/80">{f.n}</div>
                            <h3 class="mt-3 text-base font-medium text-[var(--fg-strong)]">{f.title}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{f.body}</p>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- three APIs -->
        <section class="mx-auto max-w-5xl px-6 pt-24">
            <h2 class="text-2xl font-semibold tracking-tight text-[var(--fg-strong)]">One library, three levels</h2>
            <p class="mt-3 max-w-xl text-[var(--fg-muted)]">
                Each import is a thinner wrapper over the same WASM core. Pick the lowest you need.
            </p>
            <div class="mt-10 border-y border-[var(--hairline)]">
                {
                    apis.map((a) => (
                        <a
                            href={a.href}
                            class="group grid items-baseline gap-2 border-b border-[var(--hairline)] px-2 py-5 no-underline transition last:border-b-0 hover:bg-[var(--panel-hover)] sm:grid-cols-[110px_minmax(0,1fr)_24px] sm:gap-6"
                        >
                            <span class="font-mono text-xs uppercase tracking-wider text-[var(--fg-subtle)] transition-colors group-hover:text-sky-400/80">
                                {a.tier}
                            </span>
                            <span>
                                <code class="font-mono text-sm text-[var(--fg-strong)]">{a.name}</code>
                                <span class="mt-1 block text-sm text-[var(--fg-subtle)]">{a.when}</span>
                            </span>
                            <span class="hidden text-[var(--fg-faint)] transition-colors group-hover:text-sky-400 sm:inline">→</span>
                        </a>
                    ))
                }
            </div>
        </section>

        <!-- capabilities showcase -->
        <section class="mx-auto max-w-5xl px-6 pt-24">
            <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-2xl font-semibold tracking-tight text-[var(--fg-strong)] sm:text-3xl">
                    Everything you need from the decode side
                </h2>
                <p class="mt-3 text-[var(--fg-muted)]">
                    Frames, thumbnails, metadata, audio — each a couple of lines.
                </p>
            </div>
            <div class="mt-14 flex flex-col gap-16">
                {
                    capabilities.map((cap, i) => (
                        <div class="grid items-center gap-8 lg:grid-cols-2">
                            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
                                <p class="font-mono text-xs uppercase tracking-[0.2em] text-sky-400/80">
                                    {cap.eyebrow}
                                </p>
                                <h3 class="mt-3 text-xl font-semibold tracking-tight text-[var(--fg-strong)]">
                                    {cap.title}
                                </h3>
                                <p class="mt-3 max-w-md leading-relaxed text-[var(--fg-muted)]">{cap.body}</p>
                                <a
                                    href={cap.href}
                                    class="mt-4 inline-block font-mono text-sm text-sky-400/80 no-underline transition-colors hover:text-sky-300"
                                >
                                    Read the guide →
                                </a>
                            </div>
                            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
                                <div class="rounded-xl bg-linear-to-b from-[var(--hairline)] to-transparent p-px">
                                    <div class="landing-code overflow-x-auto rounded-[11px] border border-[var(--hairline)] bg-[var(--code-bg)]">
                                        <Code code={cap.code} lang="js" theme="vesper" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- codecs callout -->
        <section class="mx-auto max-w-5xl px-6 pt-24 pb-20">
            <div class="border-t border-[var(--hairline)] pt-10">
                <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-[var(--fg-strong)]">
                    H.264, HEVC, VP8/9, AV1, ProRes — plus AAC, Opus, FLAC, and dozens more.
                </h2>
                <p class="mt-4 max-w-xl text-[var(--fg-muted)]">
                    Decode-first, with single-frame image encode for thumbnails. Compatibility is
                    tracked against FFmpeg’s FATE suite.
                </p>
                <a
                    href="/codecs/"
                    class="mt-6 inline-block font-mono text-sm text-[var(--fg-strong)] no-underline hover:underline"
                    >View the codec table →</a
                >
            </div>
        </section>

        <!-- final CTA -->
        <section class="relative overflow-hidden border-t border-[var(--hairline)]">
            <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_120%_at_50%_0%,rgba(56,189,248,0.1),transparent)]"></div>
            <div class="mx-auto max-w-2xl px-6 py-24 text-center">
                <h2 class="bg-linear-to-b from-[var(--fg-strong)] to-[var(--fg-muted)] bg-clip-text text-3xl font-semibold tracking-tight text-transparent sm:text-4xl">
                    Start decoding in the browser
                </h2>
                <p class="mx-auto mt-4 max-w-md text-[var(--fg-muted)]">
                    No build step, no special headers, no worker setup. Install and call
                    <code class="font-mono text-[var(--fg)]">load()</code>.
                </p>
                <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                    <a
                        href="/start/introduction/"
                        class="rounded-md btn-primary px-5 py-2.5 text-sm font-medium no-underline transition"
                        >Get started</a
                    >
                    <CopyCommand command="npm install wasmpeg" />
                </div>
            </div>
        </section>

        <SiteFooter />

        <style>
            /* Faint dev-tool grid behind the hero, faded out with a radial mask. */
            .hero-grid {
                background-image:
                    linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
                    linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
                background-size: 56px 56px;
                -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 0%, #000 25%, transparent 75%);
                mask-image: radial-gradient(ellipse 60% 55% at 50% 0%, #000 25%, transparent 75%);
            }

            /* Blend Astro's <Code> output into the editor window. */
            .landing-code :global(pre.astro-code) {
                margin: 0;
                padding: 1rem 1.15rem;
                background: transparent !important;
                font-size: 13px;
                line-height: 1.7;
            }
        </style>
    </body>
</html>
