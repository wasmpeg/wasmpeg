---
import '../../styles/global.css';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import { getCollection } from 'astro:content';

const title = 'Blog — wasmpeg';
const description = 'Release notes, deep-dives, and announcements from the wasmpeg project.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <ThemeScript />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href="https://wasmpeg.pages.dev/blog/" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://wasmpeg.pages.dev/og.png" />
        <meta name="twitter:card" content="summary_large_image" />
    </head>
    <body class="m-0 min-h-screen bg-[var(--bg)] font-sans text-[var(--fg)] antialiased">
        <SiteNav />

        <section class="mx-auto max-w-3xl px-6">
            <div class="pt-20 pb-10">
                <p class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-[var(--fg-subtle)]">Blog</p>
                <h1 class="bg-linear-to-b from-[var(--fg-strong)] to-[var(--fg-muted)] bg-clip-text text-4xl font-semibold tracking-tight text-transparent sm:text-5xl">
                    What's new in wasmpeg
                </h1>
                <p class="mt-4 max-w-xl text-lg leading-relaxed text-[var(--fg-muted)]">
                    Release notes, deep-dives, and announcements.
                </p>
            </div>

            <div class="border-t border-[var(--hairline)] pb-24">
                {
                    posts.length === 0 ? (
                        <p class="py-16 text-center text-[var(--fg-subtle)]">No posts yet — check back soon.</p>
                    ) : (
                        posts.map((post) => (
                            <a
                                href={`/blog/${post.id}/`}
                                class="group block border-b border-[var(--hairline)] py-8 no-underline transition-colors hover:bg-[var(--panel-hover)]"
                            >
                                <div class="flex items-center gap-3 font-mono text-xs text-[var(--fg-subtle)]">
                                    <time>{fmt(post.data.date)}</time>
                                    {post.data.tag && (
                                        <span class="rounded-full border border-[var(--hairline)] px-2 py-0.5 text-sky-400/80">
                                            {post.data.tag}
                                        </span>
                                    )}
                                </div>
                                <h2 class="mt-3 text-xl font-semibold tracking-tight text-[var(--fg-strong)] transition-colors group-hover:text-sky-300">
                                    {post.data.title}
                                </h2>
                                <p class="mt-2 leading-relaxed text-[var(--fg-muted)]">{post.data.description}</p>
                                <span class="mt-3 inline-block font-mono text-xs text-sky-400/80 group-hover:text-sky-300">
                                    Read more →
                                </span>
                            </a>
                        ))
                    )
                }
            </div>
        </section>

        <SiteFooter />
    </body>
</html>
