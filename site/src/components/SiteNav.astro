---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import logo from '../assets/logo.svg';

const GITHUB = 'https://github.com/wasmpeg/wasmpeg';
---

<header class="sticky top-0 z-30 bg-[var(--bg-blur)] backdrop-blur-xl">
    <div class="h-px w-full bg-linear-to-r from-transparent via-sky-400/60 to-transparent"></div>
    <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between border-b border-[var(--hairline)] px-6">
        <div class="flex items-center gap-3">
            <a href="/" class="group flex items-center gap-2 no-underline">
                <Image src={logo} alt="" width={22} height={22} class="transition-transform duration-300 group-hover:rotate-[8deg]" />
                <span class="text-[15px] font-medium tracking-tight text-[var(--fg-strong)]">wasmpeg</span>
            </a>
            <details class="version-menu relative hidden sm:block">
                <summary class="flex cursor-pointer list-none items-center gap-1 rounded-full border border-[var(--hairline)] px-2 py-0.5 font-mono text-[11px] text-[var(--fg-muted)] transition-colors hover:border-sky-400/40 hover:text-sky-300">
                    v0.1.0
                    <svg width="8" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </summary>
                <div class="absolute left-0 top-full z-40 mt-2 w-44 overflow-hidden rounded-lg border border-[var(--hairline)] bg-[var(--bg)] py-1 shadow-xl shadow-black/50">
                    <span class="flex items-center justify-between px-3 py-1.5 font-mono text-xs text-[var(--fg)]">
                        v0.1.0
                        <span class="rounded-full bg-sky-400/15 px-1.5 py-0.5 text-[10px] text-sky-300">latest</span>
                    </span>
                    <div class="my-1 h-px bg-[var(--hairline)]"></div>
                    <a href={GITHUB + '/releases'} class="block px-3 py-1.5 text-xs text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--panel-hover)] hover:text-sky-300">Changelog</a>
                    <a href={GITHUB + '/tags'} class="block px-3 py-1.5 text-xs text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--panel-hover)] hover:text-sky-300">All releases</a>
                </div>
            </details>
        </div>
        <div class="flex items-center gap-1 text-sm">
            <a href="/start/introduction/" class="rounded-md px-3 py-1.5 text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--panel-hover)] hover:text-sky-300">Docs</a>
            <a href="/reference/high-level/" class="hidden rounded-md px-3 py-1.5 text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--panel-hover)] hover:text-sky-300 sm:block">Reference</a>
            <a href="/codecs/" class="hidden rounded-md px-3 py-1.5 text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--panel-hover)] hover:text-sky-300 sm:block">Codecs</a>
            <a href="/blog/" class="rounded-md px-3 py-1.5 text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--panel-hover)] hover:text-sky-300">Blog</a>
            <a href="/team/" class="hidden rounded-md px-3 py-1.5 text-[var(--fg-muted)] no-underline transition-colors hover:bg-[var(--panel-hover)] hover:text-sky-300 sm:block">Team</a>
            <span class="mx-1.5 hidden h-4 w-px bg-[var(--hairline)] sm:block"></span>
            <ThemeToggle />
            <a
                href={GITHUB}
                aria-label="wasmpeg on GitHub"
                class="flex h-8 w-8 items-center justify-center rounded-md border border-[var(--hairline)] text-[var(--fg-muted)] no-underline transition-colors hover:border-sky-400/40 hover:text-sky-300"
            >
                <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                </svg>
            </a>
        </div>
    </nav>
</header>

<style>
    .version-menu > summary {
        list-style: none;
    }
    .version-menu > summary::-webkit-details-marker {
        display: none;
    }
</style>

<script>
    // Close the version dropdown when clicking outside it.
    document.addEventListener('click', (e) => {
        document.querySelectorAll('details.version-menu[open]').forEach((d) => {
            if (!d.contains(e.target as Node)) d.removeAttribute('open');
        });
    });
</script>
