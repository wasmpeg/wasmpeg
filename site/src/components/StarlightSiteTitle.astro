---
// Overrides Starlight's SiteTitle so the docs header carries the same branding
// (logo + wordmark + version chip) as the landing/team navbar. Search, theme
// toggle, and the mobile menu are untouched.
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
---

<a href="/" class="wasmpeg-title">
    <Image src={logo} alt="" width={24} height={24} />
    <span class="wasmpeg-name">wasmpeg</span>
    <span class="wasmpeg-ver">v0.1.0</span>
</a>

<style>
    .wasmpeg-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--sl-color-white);
        font-weight: 600;
        line-height: 1;
    }
    .wasmpeg-name {
        font-size: var(--sl-text-h5);
        letter-spacing: -0.01em;
    }
    .wasmpeg-ver {
        font-family: var(--sl-font-mono, ui-monospace, monospace);
        font-size: 0.6875rem;
        color: var(--sl-color-gray-3);
        border: 1px solid var(--sl-color-hairline);
        border-radius: 999px;
        padding: 0.1rem 0.4rem;
    }
    .wasmpeg-ver:hover {
        color: #7dd3fc;
    }
    @media (max-width: 30rem) {
        .wasmpeg-ver {
            display: none;
        }
    }
</style>
