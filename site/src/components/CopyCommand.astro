---
interface Props {
    command: string;
    prompt?: boolean;
}
const { command, prompt = true } = Astro.props;
---

<button
    type="button"
    class="copy-cmd group inline-flex cursor-pointer items-center gap-2.5 rounded-md border border-[var(--hairline)] bg-[var(--panel)] px-4 py-2.5 font-mono text-sm text-[var(--fg)] transition-colors hover:border-sky-400/40 hover:text-sky-200"
    data-command={command}
    aria-label={`Copy "${command}" to clipboard`}
>
    {prompt && <span class="select-none text-[var(--fg-faint)]">$</span>}
    <span>{command}</span>
    <span class="copy-icons relative ml-1 inline-flex h-4 w-4 items-center justify-center text-[var(--fg-subtle)] group-hover:text-sky-300">
        <svg class="icon-copy" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3" />
            <path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor" stroke-width="1.3" />
        </svg>
        <svg class="icon-check" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </span>
</button>

<style>
    .icon-check {
        display: none;
        color: #4ade80;
    }
    .copy-cmd.copied .icon-copy {
        display: none;
    }
    .copy-cmd.copied .icon-check {
        display: inline;
    }
</style>

<script>
    document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-cmd');
        if (!btn) return;
        try {
            await navigator.clipboard.writeText(btn.dataset.command ?? '');
            btn.classList.add('copied');
            setTimeout(() => btn.classList.remove('copied'), 1500);
        } catch {
            /* clipboard unavailable (e.g. non-secure context) — no-op */
        }
    });
</script>
