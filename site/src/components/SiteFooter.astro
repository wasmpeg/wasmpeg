---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';

const GITHUB = 'https://github.com/wasmpeg/wasmpeg';
---

<footer class="relative overflow-hidden">
    <div class="h-px w-full bg-linear-to-r from-transparent via-sky-400/40 to-transparent"></div>
    <div class="relative z-10 mx-auto max-w-5xl px-6 pt-16 pb-10">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
            <!-- brand -->
            <div class="lg:col-span-5">
                <a href="/" class="flex items-center gap-2 no-underline">
                    <Image src={logo} alt="" width={22} height={22} />
                    <span class="text-[15px] font-medium tracking-tight text-[var(--fg-strong)]">wasmpeg</span>
                </a>
                <p class="mt-4 max-w-xs text-sm leading-relaxed text-[var(--fg-subtle)]">
                    FFmpeg for the browser, built for the decode → display loop. Frames, audio,
                    and metadata from a 2.9&nbsp;MB WASM.
                </p>
                <p class="mt-5 font-mono text-xs text-[var(--fg-faint)]">LGPL-2.1-or-later</p>
            </div>

            <!-- link columns -->
            <div class="lg:col-span-7">
                <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
                    <div>
                        <h3 class="font-mono text-xs uppercase tracking-wider text-[var(--fg-subtle)]">Docs</h3>
                        <ul class="mt-4 space-y-3 text-sm">
                            <li><a href="/start/introduction/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Introduction</a></li>
                            <li><a href="/start/installation/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Installation</a></li>
                            <li><a href="/start/quick-start/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Quick start</a></li>
                            <li><a href="/guides/ffmpeg-recipes/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">FFmpeg → wasmpeg</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="font-mono text-xs uppercase tracking-wider text-[var(--fg-subtle)]">Reference</h3>
                        <ul class="mt-4 space-y-3 text-sm">
                            <li><a href="/reference/high-level/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">High-level API</a></li>
                            <li><a href="/reference/gpu/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">gpu namespace</a></li>
                            <li><a href="/reference/c-abi/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">C ABI</a></li>
                            <li><a href="/filters/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Filters</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="font-mono text-xs uppercase tracking-wider text-[var(--fg-subtle)]">Project</h3>
                        <ul class="mt-4 space-y-3 text-sm">
                            <li><a href="/blog/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Blog</a></li>
                            <li><a href="/codecs/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Codec support</a></li>
                            <li><a href="/team/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Team</a></li>
                            <li><a href="/build/from-source/" class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">Building</a></li>
                            <li><a href={GITHUB} class="text-[var(--fg-muted)] no-underline transition-colors hover:text-sky-300">GitHub</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-14 flex flex-col gap-3 border-t border-[var(--hairline)] pt-6 text-sm text-[var(--fg-subtle)] sm:flex-row sm:items-center sm:justify-between">
            <span>© 2026 wasmpeg</span>
            <span>Built with love by the <a href="/team/" class="text-[var(--fg)] no-underline transition-colors hover:text-sky-300">team behind wasmpeg</a></span>
        </div>
    </div>

    <!-- watermark wordmark -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-6 left-1/2 -z-0 w-full -translate-x-1/2 select-none bg-linear-to-b from-[var(--watermark)] to-transparent bg-clip-text text-center text-[20vw] font-bold leading-none tracking-tighter text-transparent"
    >
        wasmpeg
    </div>
</footer>
