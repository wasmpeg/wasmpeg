---
// Sets data-theme before paint to avoid a flash, reading the same key Starlight
// uses so the choice is shared across the docs and the custom pages.
---

<script is:inline>
    (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
            stored === 'light' || stored === 'dark'
                ? stored
                : window.matchMedia('(prefers-color-scheme: dark)').matches
                  ? 'dark'
                  : 'light';
        document.documentElement.dataset.theme = theme;
    })();
</script>
