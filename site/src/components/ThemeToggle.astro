---
// Theme toggle for the custom pages. Persists to the same localStorage key as
// Starlight's own toggle, so the whole site stays in sync.
---

<button
    type="button"
    class="theme-toggle group flex h-8 w-8 items-center justify-center rounded-md text-[var(--fg-muted)] transition-colors hover:bg-[var(--panel-hover)] hover:text-[var(--fg-faint)]"
    aria-label="Toggle light/dark theme"
>
    <svg class="ic-sun transition-transform duration-300 group-hover:rotate-45" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="ic-moon transition-transform duration-300 group-hover:-rotate-12" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
</button>

<script>
    document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.theme-toggle')) return;
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
            localStorage.setItem('starlight-theme', next);
        } catch {
            /* storage unavailable — toggle still applies for this page */
        }
    });
</script>
